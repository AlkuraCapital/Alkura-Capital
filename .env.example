# ─────────────────────────────────────────────────────────────────────────────
# LeadHearth — environment variables (copy to .env and fill in)
# NEVER commit the real .env. This template lists every key Phase 1+ needs.
# Each provider + how to get the key is documented in docs/phase-0-setup-checklist.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Core / app ──
APP_ENV=sandbox                      # sandbox | production  (start in sandbox)
APP_BASE_URL=http://localhost:3000
BRAND_NAME=LeadHearth
COMPANY_LEGAL_NAME=                  # LLC legal name (used in email footers)
COMPANY_MAILING_ADDRESS=            # physical address — required by CAN-SPAM in every email

# ── AI brain (Anthropic) ──
ANTHROPIC_API_KEY=
# Model routing (defaults; override only if needed):
AI_MODEL_BULK=claude-haiku-4-5-20251001   # high-volume personalization
AI_MODEL_QUALITY=claude-sonnet-4-6        # audits + customer-facing copy
AI_MODEL_PREMIUM=claude-opus-4-8          # highest-stakes copy / escalations

# ── Cold-email outreach (SmartLead OR Instantly) ──
SMARTLEAD_API_KEY=
# INSTANTLY_API_KEY=                 # use one or the other
OUTREACH_DOMAINS=                    # comma-separated, e.g. leadhearth.co,gethearthleads.com
OUTREACH_FROM_NAME=                  # neutral sender display name

# ── Fulfillment email (client-domain sends: Resend OR SendGrid) ──
RESEND_API_KEY=
# SENDGRID_API_KEY=

# ── Audit data (Google Places) ──
GOOGLE_PLACES_API_KEY=

# ── AI voice agent (Vapi OR Retell) ──
VAPI_API_KEY=
# RETELL_API_KEY=
VOICE_AGENT_PHONE_NUMBER=           # provisioned number for outbound/inbound calls

# ── Payments (Stripe) ──
STRIPE_SECRET_KEY=                   # use sk_test_... while APP_ENV=sandbox
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_SETUP_FEE=              # price/product id for the $300–500 setup fee
STRIPE_METER_PER_RESULT=            # metered billing id for per-booked-job charges

# ── Database (Supabase / Postgres) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DATABASE_URL=                        # postgres connection string

# ── Ops / notifications ──
ADMIN_ALERT_EMAIL=                   # where the system emails you approvals & alerts
